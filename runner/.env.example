# Nome desta máquina nos runners (factory-<nome>-1, -2...). Copie para .env.
FACTORY_MACHINE=meu-notebook
# Só na primeira subida de cada runner; um owner gera (README). Pode apagar depois.
FACTORY_REGISTRATION_TOKEN=
# A organização do GitHub onde os runners entram. Para um repositório de conta pessoal,
# use dono/repositório.
FACTORY_ORG=minha-org
# Opcional: credenciais guardadas no runner, para os repositórios não precisarem de segredos
# (README, "Credenciais no runner"). Não edite à mão: `bash set-credentials.sh` pergunta os
# valores sem mostrá-los. O token do FG Tracker (modelo "FG Factory") também envia o sinal desta
# máquina ao painel.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FG_TRACKER_TOKEN=
# Opcional: um token separado só para o painel (modelo "FG Factory (relatos)"). Vence o de cima.
FG_TRACKER_FACTORY_TOKEN=
# Opcional: qual CLI esta máquina usa e como (README, "Claude Code ou Codex"). Vazio = claude,
# com o modelo padrão da conta. O que o workflow do repositório pedir vence o que está aqui.
# FACTORY_AGENT=codex            # claude ou codex: quem tria e corrige
# FACTORY_REVIEW_AGENT=claude    # quem revisa (vazio = o mesmo de cima)
# FACTORY_CODEX_MODEL=           # ex.: o mesmo nome que você usa em `codex -m`
# FACTORY_CODEX_EFFORT=          # low, medium, high, xhigh... (o que o modelo aceitar)
# FACTORY_CODEX_FAST=true        # modo rápido (service_tier fast)
# FACTORY_CLAUDE_MODEL=
# FACTORY_CLAUDE_EFFORT=
# FACTORY_CLAUDE_FAST=true
# Só para instalações próprias do FG Tracker.
# FG_TRACKER_URL=https://tracker-api.fortground.com.br

# Opcional: um Docker próprio para cada runner (README, "Docker dentro do runner"). O contêiner
# passa a rodar privilegiado.
# COMPOSE_FILE=compose.yml:compose.docker.yml

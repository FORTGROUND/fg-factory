# Nome desta máquina nos runners (factory-<nome>-1, -2...). Copie para .env.
FACTORY_MACHINE=meu-notebook
# Só na primeira subida de cada runner; um owner gera (README). Pode apagar depois.
FACTORY_REGISTRATION_TOKEN=
# A organização do GitHub onde os runners entram. Para um repositório de conta pessoal,
# use dono/repositório.
FACTORY_ORG=minha-org
